{
  "name": "pure-swipe-slider",
  "version": "1.1.0",
  "description": "A tiny, zero-dependency swipe slider web component (< 4 KB gzipped).",
  "type": "module",
  "main": "./swipe-slider.js",
  "module": "./swipe-slider.js",
  "types": "./swipe-slider.d.ts",
  "customElements": "custom-elements.json",
  "sideEffects": [
    "register.js",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./swipe-slider.d.ts",
      "default": "./swipe-slider.js"
    },
    "./register.js": "./register.js",
    "./swipe-slider.css": "./swipe-slider.css",
    "./swipe3.js": {
      "types": "./swipe3.d.ts",
      "default": "./swipe3.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "swipe-slider.js",
    "swipe-slider.d.ts",
    "swipe3.js",
    "swipe3.d.ts",
    "swipe-slider.css",
    "register.js",
    "custom-elements.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "minify": "mkdir -p dist && bun build swipe-slider.js --minify --outfile=dist/swipe-slider.min.js && bun build swipe-slider.css --minify --outfile=dist/swipe-slider.min.css",
    "gzip": "cd dist && gzip -f -k *.min.*",
    "brotli": "cd dist && brotli -f -q 11 swipe-slider.min.js swipe-slider.min.css",
    "compress": "npm run gzip && npm run brotli",
    "build": "npm run minify && npm run compress",
    "test": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexstep/swipe-slider.git"
  },
  "keywords": [
    "web-component",
    "swipe",
    "slider",
    "carousel",
    "touch",
    "mobile-first",
    "pointer-events"
  ],
  "author": "alexstep",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alexstep/swipe-slider/issues"
  },
  "homepage": "https://github.com/alexstep/swipe-slider#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
